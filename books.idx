json) { if (alive) setDataset(json); }) .catch(function (e) { if (alive) setError(e.message); }); return function () { alive = false; }; }, [src]); const graph = useMemo(function () { return dataset && Array.isArray(dataset['@graph']) ? dataset['@graph'] : []; }, [datase","g":"","r":1.0,"m":0,"n":"src jsx src jsx sutoorminawal jsx واجهه استعراض وبحث تقرا قاعده البيانات مباشره منصه سطور من اوال 2 0 https sutoorawwal com الاستعمال import sutoorminawal from sutoorminawal jsx المتطلبات react 18 فما sutoorminawal jsx واجهه استعراض وبحث تقرا قاعده البيانات مباشره منصه سطور من اوال 2 0 https sutoorawwal com الاستعمال import sutoorminawal from sutoorminawal jsx المتطلبات react 18 فما فوق الانماط مضمنه فلا حاجه الي مكتبه تنسيق import react usestate useeffect usememo from react export function normalizearabic input return string input null input replace u064b u065f u0670 g replace u0640 g replace u0622 u0623 u0625 u0671 g u0627 replace u0629 g u0647 replace u0649 g u064a replace u0624 g u0648 replace u0626 g u064a replace s g trim tolowercase const palette ink 191d12 card 212617 edge rgba 224 205 155 16 fg efe6ce dim b3a986 brass c89b3f seal 4fa891 export default function sutoorminawal props const src props src ontology database json const dataset setdataset usestate null const error seterror usestate null const query setquery usestate const category setcategory usestate الكل const openid setopenid usestate null useeffect function let alive true fetch src then function r if r ok throw new error تعذر تحميل القاعده return r json then function json if alive setdataset json catch function e if alive seterror e message return function alive false src const graph usememo function return dataset array isarray dataset graph dataset graph dataset const categories usememo function const set new set graph map function n return n category filter boolean return الكل concat array from set graph const results usememo function const q normalizearabic query return graph filter function n cons