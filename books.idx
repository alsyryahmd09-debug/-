طويل ويوحّد الحروف المتقاربة ── */ function normalizeArabic(input) { return String(input == null ? '' : input) .replace(/[\\u064B-\\u065F\\u0670]/g, '') .replace(/\\u0640/g, '') .replace(/[\\u0622\\u0623\\u0625\\u0671]/g, '\\u0627') .replace(/\\u0629/g, '\\u0647') .replace(/\\u0649/g, '\\u064A') .replace(/\\u0624/g, '\\u0648') .replace(/\\u0626/g, '\\u064A') .replace(/[\\u200C-\\u200F\\u061C]/g, '') .replace(/\\s+/g, ' ') .trim() .toLowerCase(); } /* ── تحميل القاعدة مرّة واحدة مع فهرس بحث مسبق التطبيع ── */ let dataset = { '@graph': [] }; let searchIndex = []; function loadDatabase() { const raw = fs.readFileSync(DB_PATH, 'utf8').replace(/^\\uFEFF/, ''); dataset = JSON.parse(raw); const graph = Array.isArray(dataset['@graph']) ? dataset['@graph'] : []; searchIndex = graph.map(function (node) { const haystack = [node.name, node.description, node.place, node.evidence, node.category, node.hijri, node.gregorian] .filter(Boolean).join(' '); return { node: node, key: normalizeArabic(haystack) }; }); console.log('حُمّلت القاعدة: ' + graph.length + ' كيانًا.'); } loadDatabase(); app.use(function (req, res, next) { res.set('Access-Control-Allow-Origin', '*'); res.set('Content-Type', 'application/json; charset=utf-8'); next(); }); /* ── نقاط النهاية ── */ app.get('/api/health', function (req, res) { res.json({ status: 'ok', entitie","g":"","r":1.0,"m":0,"n":"src server جز 2 src server use strict const express require express const fs require fs const path require path const app express const port process env port 3000 const db_path path join __dirname ontology da use strict const express require express const fs require fs const path require path const app express const port process env port 3000 const db_path path join __dirname ontology database json تطبيع النص العربي يزيل التشكيل والتطويل ويوحد الحروف المتقاربه function normalizearabic input return string input null input replace u064b u065f u0670 g replace u0640 g replace u0622 u0623 u0625 u0671 g u0627 replace u0629 g u